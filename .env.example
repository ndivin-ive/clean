# Copy to .env.local for `pnpm dev`. Never commit real secrets.

# Runtime connection: non-owner role, row-level security applies.
DATABASE_URL=postgres://clean_app:clean_app@localhost:5432/clean
# Migration/seed connection: table owner.
DATABASE_URL_OWNER=postgres://clean_owner:clean_owner@localhost:5432/clean

# Test databases (integration + e2e).
TEST_DATABASE_URL=postgres://clean_app:clean_app@localhost:5432/clean_test
TEST_DATABASE_URL_OWNER=postgres://clean_owner:clean_owner@localhost:5432/clean_test

# Local mail catcher (Mailpit).
SMTP_URL=smtp://localhost:1025
MAILPIT_API_URL=http://localhost:8025
EMAIL_FROM="CLEAN <no-reply@clean.localhost>"

APP_URL=http://localhost:3000

# Better Auth. Generate a real secret per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000

# Outgoing mail is refused unless the SMTP host is local (Mailpit / test sink)
# or this is set to true after explicit approval (CLAUDE.md stop-and-ask rule).
MAIL_ALLOW_EXTERNAL=false

# End-to-end test database (reset by Playwright global setup).
E2E_DATABASE_URL=postgres://clean_app:clean_app@localhost:5432/clean_e2e
E2E_DATABASE_URL_OWNER=postgres://clean_owner:clean_owner@localhost:5432/clean_e2e
